generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYE
}

model User {
  id            String   @id @default(uuid())
  nom           String
  email         String   @unique
  password      String
  role          Role     @default(EMPLOYE)
  employeId     String?  @unique
  employe       Employe? @relation(fields: [employeId], references: [id])
  congesTraites Conge[]  @relation("CongeTraitePar")
  createdAt     DateTime @default(now())

  @@map("users")
}

model Chantier {
  id              String     @id @default(uuid())
  nom             String
  latitude        Float
  longitude       Float
  rayonToleranceM Int
  createdAt       DateTime   @default(now())
  updateAt        DateTime   @updatedAt
  employes        Employe[]
  pointages       Pointage[]

  @@map("chantier")
}

model Employe {
  id                       String     @id @default(uuid())
  nom                      String
  prenom                   String
  tauxHoraire              Decimal    @db.Decimal(10, 2)
  volumeMensuelObligatoire Int
  // Facultatif : sert à lier automatiquement un compte EMPLOYE à sa fiche (comparaison sans casse).
  email                    String?    @unique
  // Facultatif : une fiche créée à l'inscription n'a pas encore de chantier.
  chantierId               String?
  badge                    Badge?
  // onDelete: Restrict conserve le comportement d'avant (suppression d'un chantier refusée s'il a des employés).
  chantier                 Chantier?  @relation(fields: [chantierId], references: [id], onDelete: Restrict)
  pointages                Pointage[]
  conges                   Conge[]
  user                     User?

  @@map("employes")
}

enum StatutConge {
  EN_ATTENTE
  VALIDE
  REFUSE
}

model Conge {
  id String @id @default(uuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  dateDebut DateTime
  dateFin   DateTime

  // Motif de la demande, facultatif (saisi par l'employé ou l'admin qui crée le congé).
  motif String?

  statut      StatutConge @default(EN_ATTENTE)
  motifRefus  String?
  traiteParId String?
  traitePar   User?       @relation("CongeTraitePar", fields: [traiteParId], references: [id])
  traiteLe    DateTime?

  createdAt DateTime @default(now())

  @@map("conges")
}

model Badge {
  id        String   @id @default(uuid())
  uid       String   @unique
  actif     Boolean  @default(true)
  employeId String   @unique
  createdAt DateTime @default(now())
  employe   Employe  @relation(fields: [employeId], references: [id])

  @@map("badges")
}

model Pointage {
  id            String         @id @default(uuid())
  employeId     String
  chantierId    String
  latitude      Float?
  longitude     Float?
  satellites    Float?
  alertHorsZone Boolean
  status        StatutPointage
  timestamp     DateTime       @default(now())
  chantier      Chantier       @relation(fields: [chantierId], references: [id])
  employe       Employe        @relation(fields: [employeId], references: [id])

  @@map("pointage")
}

enum StatutPointage {
  ENTREE
  SORTIE
}
